# 백엔드(main.py / collector.py / pb_engine.py)가 사용하는 환경 변수.
# 실제 값을 채운 .env 파일은 절대 커밋하지 말 것 (.gitignore에 이미 제외됨).
# 배포 시에는 이 값들을 Render 대시보드의 Environment 탭에 직접 등록한다.

# Open DART(전자공시) API 인증키 - https://opendart.fss.or.kr
DART_API_KEY=

# FRED(미국 거시경제 지표) API 인증키 - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# (선택) data.krx.co.kr 로그인 정보. 국내 기관/외국인 순매수 수급 데이터는 KRX가
# 비로그인 요청을 거부하기 때문에(HTTP 400 "LOGOUT") 이 값이 없으면 해당 항목만 비어서
# 나온다(나머지 리포트 생성에는 영향 없음). 실제 KRX 계정 로그인 정보이므로 신뢰할 수
# 있는 곳에만 등록할 것.
KRX_ID=
KRX_PW=

# AI 리포트 생성 provider: openai | gemini (생략 시 아래 키가 설정된 쪽으로 자동 판단)
AI_PROVIDER=

# OpenAI 사용 시
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini 사용 시
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 프론트엔드를 호출을 허용할 오리진(콤마로 여러 개 지정 가능).
# 미설정 시 기본값(운영 Vercel 도메인)만 허용된다.
ALLOWED_ORIGINS=https://ai-pb-service-7chm.vercel.app
